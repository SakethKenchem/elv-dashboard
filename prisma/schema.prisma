// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesData     SalesData[]
  regions       Region[]
  salesManagers SalesManager[]
  vendors       Vendor[]
}

model Region {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId])
}

model SalesManager {
  id        Int      @id @default(autoincrement())
  name      String
  region    String?
  vendor    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  yearTarget      Float  @default(0)
  quarterTarget   Float  @default(0)
  monthTarget     Float  @default(0)
  selectedQuarter Int    @default(1)
  monthlyTargets  Json?
  monthlyAchieved Json?
  commitMonth     String?
  commitAmount    Float?

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Vendor {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId])
}

model SalesData {
  id            Int     @id @default(autoincrement())
  region        String
  salesManager  String
  vendor        String

  ownerId       Int
  owner         User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  yearTarget    Float
  quarterTarget Float
  monthTarget   Float
  selectedQuarter Int   @default(1)
  monthlyTargets  Json?
  monthlyAchieved Json?

  month1Name    String  @default("JAN")
  month2Name    String  @default("FEB")
  month3Name    String  @default("MAR")

  jan           Float?
  feb           Float?
  mar           Float?

  totalAchieved Float?
  commitMonth   String  @default("MAR")
  commitMar     Float?
  commitAmount  Float?

  percentQ1     Float?
  balanceQ1     Float?

  @@index([ownerId])
  @@index([ownerId, region])
  @@index([ownerId, salesManager])
  @@index([ownerId, vendor])
}